# URL e chave PUBLICA publishable do projeto Supabase. Nunca use service_role ou sb_secret aqui.
EXPO_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_substitua
# Habilite somente depois de configurar Google no Supabase e gerar development build.
EXPO_PUBLIC_GOOGLE_AUTH_ENABLED=false
